<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/git__fragment__root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <!-- States 1 and 2: no repository configured / a folder that is not a repository -->
    <ScrollView
        android:id="@+id/git__fragment__setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.5"
                android:contentDescription="@string/git"
                android:src="@drawable/ic_git_branch_black_24dp"
                app:tint="@color/secondary_text" />

            <TextView
                android:id="@+id/git__fragment__setup_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/primary_text"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="@string/git_tab__no_repo_title" />

            <TextView
                android:id="@+id/git__fragment__setup_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/secondary_text"
                android:textSize="14sp"
                tools:text="@string/git_tab__no_repo_message" />

            <Button
                android:id="@+id/git__fragment__setup_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                tools:text="@string/git_tab__select_folder" />

            <Button
                android:id="@+id/git__fragment__setup_secondary"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="@string/git_clone__title" />

            <Button
                android:id="@+id/git__fragment__setup_suggestion"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                tools:text="@string/git_tab__use_notebook_folder"
                tools:visibility="visible" />
        </LinearLayout>
    </ScrollView>

    <!-- State 3: a repository is open -->
    <LinearLayout
        android:id="@+id/git__fragment__repo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Header: repository, branch, ahead/behind, last fetch, progress, actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/git__fragment__repo_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="@color/primary_text"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="notes" />

                <ImageButton
                    android:id="@+id/git__fragment__overflow"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/more"
                    android:src="@drawable/ic_more_vert_black_24dp"
                    app:tint="@color/secondary_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="0dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_git_branch_black_24dp"
                    app:tint="@color/secondary_text" />

                <TextView
                    android:id="@+id/git__fragment__branch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/secondary_text"
                    android:textSize="14sp"
                    tools:text="main" />

                <TextView
                    android:id="@+id/git__fragment__ahead_behind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/secondary_text"
                    android:textSize="14sp"
                    android:typeface="monospace"
                    tools:text="↑2 ↓1" />
            </LinearLayout>

            <TextView
                android:id="@+id/git__fragment__sync_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:paddingStart="0dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="@color/secondary_text"
                android:textSize="12sp"
                tools:text="@string/git_tab__never_fetched" />

            <!-- Progress: shown while an operation runs, with a Cancel affordance -->
            <LinearLayout
                android:id="@+id/git__fragment__progress_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/git__fragment__progress_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp"
                    tools:text="Receiving objects 42%" />

                <!-- Cancels the running git operation; not a dialog button bar, hence ButtonOrder. -->
                <Button
                    android:id="@+id/git__fragment__progress_cancel"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@android:string/cancel"
                    android:textSize="13sp"
                    tools:ignore="ButtonOrder" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/git__fragment__progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:paddingStart="0dp"
                android:paddingEnd="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Task 5.3: replaces the action row while a merge or rebase waits for conflict resolution -->
            <LinearLayout
                android:id="@+id/git__fragment__conflict_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/git__conflict_banner_background"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/git__fragment__conflict_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/git_tab__resolving_title"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/git__fragment__conflict_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/primary_text"
                    android:textSize="13sp"
                    tools:text="@string/git_tab__resolving_rebase" />

                <!-- One git__fragment__status_item row per conflicted file, added in code; tap opens the editor -->
                <LinearLayout
                    android:id="@+id/git__fragment__conflict_files"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="-12dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/git__fragment__conflict_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/git__fragment__abort"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/git_tab__abort"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/git__fragment__mark_resolved"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/git_tab__mark_resolved"
                        android:textColor="@color/accent"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Action row -->
            <LinearLayout
                android:id="@+id/git__fragment__actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="0dp"
                android:paddingEnd="8dp">

                <Button
                    android:id="@+id/git__fragment__pull"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/git_tab__pull"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/git__fragment__commit"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/git_commit_ellipsis"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/git__fragment__push"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/git_tab__push"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Segmented switch: Changes / History -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/git__fragment__segment_changes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/git__segment_background"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textAllCaps="true"
                android:textColor="@color/git__segment_text"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Changes (3)" />

            <TextView
                android:id="@+id/git__fragment__segment_history"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/git__segment_background"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/git_tab__history"
                android:textAllCaps="true"
                android:textColor="@color/git__segment_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/git__fragment__swipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/git__fragment__list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <TextView
                    android:id="@+id/git__fragment__empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingTop="48dp"
                    android:paddingEnd="24dp"
                    android:textColor="@color/secondary_text"
                    android:textSize="15sp"
                    android:visibility="gone"
                    tools:text="@string/git_tab__nothing_to_commit"
                    tools:visibility="visible" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
</FrameLayout>
