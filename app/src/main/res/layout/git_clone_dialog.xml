<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/git_clone_dialog__root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/activity_horizontal_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_horizontal_margin"
    android:paddingEnd="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/git_clone_dialog__form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/git_remote__url"
                android:textAppearance="@style/TextAppearance.AppCompat.Caption" />

            <EditText
                android:id="@+id/git_clone_dialog__url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/git_remote__url_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:singleLine="true"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/git_clone__target_folder"
                android:textAppearance="@style/TextAppearance.AppCompat.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/git_clone_dialog__folder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:lines="1"
                    android:text="@string/git_clone__no_folder"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/git_clone_dialog__choose_folder"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/git_clone__choose_folder" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/git_remote__credentials_optional"
                android:textAppearance="@style/TextAppearance.AppCompat.Caption" />

            <EditText
                android:id="@+id/git_clone_dialog__username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/git_remote__username"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:singleLine="true"
                android:textSize="15sp" />

            <!-- saveEnabled=false: an EditText puts its text into the saved instance state, and the
                 system may write that Bundle to disk on process death. The token must never leave
                 the Keystore-backed store, so it is dropped on rotation instead (decision D4). -->
            <EditText
                android:id="@+id/git_clone_dialog__token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/git_remote__token"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:saveEnabled="false"
                android:singleLine="true"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/git_clone_dialog__not_persisted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/git_remote__token_not_persisted"
                android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/git_clone_dialog__progress_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/git_clone_dialog__progress_task"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lines="1"
                android:text="@string/git_clone__progress"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/git_clone_dialog__progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:max="100" />
        </LinearLayout>

        <TextView
            android:id="@+id/git_clone_dialog__status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Caption"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
