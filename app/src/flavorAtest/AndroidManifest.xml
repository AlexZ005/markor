<?xml version="1.0" encoding="utf-8"?><!--
    Test-flavour only. Manual entry points that never ship in flavorDefault or flavorGplay:
    - net.gsantner.markor.git.test.GitCommitDialogTestActivity: the Git tab's commit dialog (task 4.1)
    - net.gsantner.markor.git.spike.GitSpikeActivity: JGit feasibility table (task 1.2), start with
      adb shell am start -n net.gsantner.markor_test/net.gsantner.markor.git.spike.GitSpikeActivity
    - net.gsantner.markor.git.ui.GitUiDebugActivity: opens the Git tab's read-only screens from adb (tasks 6.1/6.2)
    - net.gsantner.markor.git.test.GitRemoteDialogsTestActivity: the clone / remote-setup dialogs (tasks 5.1/5.2)
    - net.gsantner.markor.git.spike.GitSshSpikeActivity: SSH feasibility table (task 8.1a), start with
      adb shell am start -n net.gsantner.markor_test/net.gsantner.markor.git.spike.GitSshSpikeActivity
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="net.gsantner.markor.git.test.GitCommitDialogTestActivity"
            android:exported="true"
            android:label="Git commit dialog (test)"
            android:theme="@style/AppTheme.Unified" />
        <activity
            android:name="net.gsantner.markor.git.test.GitRemoteDialogsTestActivity"
            android:exported="true"
            android:label="Git remote dialogs (test)"
            android:theme="@style/AppTheme.Unified" />
        <activity
            android:name="net.gsantner.markor.git.spike.GitSpikeActivity"
            android:exported="true"
            android:label="Git spike"
            android:theme="@style/AppTheme.Unified" />
        <activity
            android:name="net.gsantner.markor.git.spike.GitSshSpikeActivity"
            android:exported="true"
            android:label="Git SSH spike"
            android:theme="@style/AppTheme.Unified" />
        <activity
            android:name="net.gsantner.markor.git.ui.GitUiDebugActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>

</manifest>
